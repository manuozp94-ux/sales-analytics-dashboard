# --------------------------------------------------------------------
# Microsoft Fabric bootstrap template
# Fill these values outside Git. Do not commit live secrets.
# --------------------------------------------------------------------

# Core authentication
FABRIC_TENANT_ID="<entra-tenant-guid>"
FABRIC_CLIENT_ID="<service-principal-client-id-guid>"
FABRIC_CLIENT_SECRET="<service-principal-client-secret>"

# Optional manual REST fallback
FABRIC_BEARER_TOKEN="<optional-short-lived-fabric-bearer-token>"
FABRIC_API_BASE_URL="<fabric-api-base-url>"

# Workspace targeting
FABRIC_WORKSPACE_ID="<fabric-workspace-guid>"
FABRIC_WORKSPACE_NAME="<fabric-workspace-name>"

# Warehouse targeting
FABRIC_WAREHOUSE_NAME="<fabric-warehouse-name>"
FABRIC_WAREHOUSE_DATABASE="<fabric-warehouse-database-name>"
FABRIC_WAREHOUSE_SQL_ENDPOINT="<warehouse-host>.datawarehouse.fabric.microsoft.com,1433"

# Optional tooling override
SQLCMD_BIN="<sqlcmd-binary-path>"
